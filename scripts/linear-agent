#!/usr/bin/env bash
set -euo pipefail

COMMAND=${1:-}
if [ -z "$COMMAND" ]; then
  echo "Usage: linear-agent <init|start|block|verify|complete|handoff|finalize> [args]" >&2
  exit 2
fi
shift

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SKILL_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
TEMPLATE=${LINEAR_AGENT_TEMPLATE:-"$SKILL_DIR/templates/EXECUTION.md"}

timestamp() {
  TZ=Australia/Brisbane date '+%Y-%m-%d %H:%M:%S %Z'
}

usage() {
  local code=${1:-2}
  local output=/dev/stderr
  if [ "$code" -eq 0 ]; then
    output=/dev/stdout
  fi

  cat >"$output" <<'EOF'
Usage:
  linear-agent init --ledger PATH --project NAME --prompt TEXT [--linear-project NAME] [--repo PATH] [--base-branch BRANCH] [--force]
  linear-agent start ISSUE --ledger PATH [--agent NAME] [--worktree PATH] [--note TEXT] [--parallel-write]
  linear-agent block ISSUE --ledger PATH [--agent NAME] [--note TEXT] [--next TEXT]
  linear-agent verify ISSUE --ledger PATH [--agent NAME] [--verification TEXT] [--note TEXT]
  linear-agent complete ISSUE --ledger PATH [--agent NAME] --verification TEXT [--note TEXT]
  linear-agent handoff --ledger PATH [--note TEXT] [--next TEXT]
  linear-agent finalize --ledger PATH [--agent NAME] --verification TEXT --linear-reconciled --dependencies VALUE --production-gates VALUE --sink-gates VALUE [--note TEXT]
  linear-agent reconcile --ledger PATH

This wrapper updates the companion execution ledger and prints the Linear MCP
actions the agent must perform and read-back verify. Add --apply-linear or set
LINEAR_AGENT_APPLY=1 on issue transition commands to apply the Linear state
change and comment directly through Linear GraphQL before confirming the ledger.
EOF
  exit "$code"
}

need_value() {
  local flag=$1
  local value=${2:-}
  if [ -z "$value" ]; then
    echo "Missing value for $flag" >&2
    exit 2
  fi
}

replace_line() {
  local file=$1
  local prefix=$2
  local replacement=$3
  local tmp
  local replacement_file

  tmp=$(mktemp)
  replacement_file=$(mktemp)
  printf '%s\n' "$replacement" >"$replacement_file"

  awk -v prefix="$prefix" -v replacement_file="$replacement_file" '
    function print_replacement() {
      while ((getline line < replacement_file) > 0) {
        print line
      }
      close(replacement_file)
    }
    index($0, prefix) == 1 { print_replacement(); next }
    { print }
  ' "$file" >"$tmp"
  rm -f "$replacement_file"
  mv "$tmp" "$file"
}

escape_table_cell() {
  local value=${1:-}

  value=${value//\\/\\\\}
  value=${value//$'\r'/}
  value=${value//$'\n'/<br>}
  value=${value//|/\\\\|}
  printf '%s' "$value"
}

clear_activity_tbd() {
  local file=$1
  local tmp

  tmp=$(mktemp)
  awk '
    /^## Activity Log$/ { in_activity=1; print; next }
    /^## / && in_activity == 1 { in_activity=0 }
    in_activity == 1 && $0 == "- TBD" { next }
    { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

append_activity() {
  local file=$1
  local message=$2

  clear_activity_tbd "$file"
  if ! grep -Fq "## Activity Log" "$file"; then
    printf '\n## Activity Log\n\n' >>"$file"
  fi
  printf -- '- %s - %s\n' "$(timestamp)" "$message" >>"$file"
}

set_check_item() {
  local file=$1
  local label=$2
  local marker=$3
  local replacement=$4
  local tmp

  tmp=$(mktemp)
  awk -v label="$label" -v marker="$marker" -v replacement="$replacement" '
    /^\- \[[ x~]\] / {
      text=substr($0, 7)
      if (index(text, label) == 1) {
        print "- [" marker "] " replacement
        next
      }
    }
    { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

remove_empty_issue_row() {
  local file=$1
  local tmp

  tmp=$(mktemp)
  awk '
    $0 == "|  |  |  |  |  |  |  |" { next }
    { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

ensure_checklist_legend() {
  local file=$1
  local tmp

  if grep -Fq "Checklist marker legend:" "$file"; then
    return
  fi

  tmp=$(mktemp)
  awk '
    { print }
    /^- Next safest action:/ {
      print ""
      print "Checklist marker legend: `[ ]` pending, `[x]` complete, `[~]` not applicable with a reason. During final reconciliation, do not leave conditional items unchecked if they were intentionally not needed."
    }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

ensure_final_reconciliation_item() {
  local file=$1
  local tmp

  if grep -Fq "Final ledger reconciliation completed" "$file"; then
    return
  fi

  tmp=$(mktemp)
  awk '
    { print }
    $0 == "- [ ] Final verification/release gate completed" || $0 == "- [x] Final verification/release gate completed" {
      print "- [ ] Final ledger reconciliation completed"
    }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

trim() {
  sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

existing_worktree() {
  local file=$1
  local issue=$2

  ISSUE="$issue" perl -ne '
    chomp;
    my $issue = $ENV{"ISSUE"};
    next unless /^\|\s*\Q$issue\E\s*\|/;

    my @cells;
    my $current = "";
    my $escaped = 0;
    for my $char (split //) {
      if ($escaped) {
        $current .= $char;
        $escaped = 0;
        next;
      }
      if ($char eq "\\") {
        $escaped = 1;
        next;
      }
      if ($char eq "|") {
        push @cells, $current;
        $current = "";
        next;
      }
      $current .= $char;
    }
    push @cells, $current;

    my $value = $cells[5] // "";
    $value =~ s/^\s+|\s+$//g;
    $value =~ s/<br>/\n/g;
    print $value;
    exit;
  ' "$file"
}

ledger_issue_rows() {
  local file=$1

  perl -ne '
    BEGIN { $in_table = 0; }
    chomp;
    if ($_ eq "## Issue Progress") {
      $in_table = 1;
      next;
    }
    last if $in_table && /^## /;
    next unless $in_table && /^\|/;
    next if /^\|\s*(Issue|---)\s*\|/;

    my @cells;
    my $current = "";
    my $escaped = 0;
    my $content = $_;
    $content =~ s/^\|//;
    $content =~ s/\|$//;
    for my $char (split //, $content) {
      if ($escaped) {
        $current .= $char;
        $escaped = 0;
        next;
      }
      if ($char eq "\\") {
        $escaped = 1;
        next;
      }
      if ($char eq "|") {
        $current =~ s/^\s+|\s+$//g;
        $current =~ s/<br>/\n/g;
        push @cells, $current;
        $current = "";
        next;
      }
      $current .= $char;
    }
    $current =~ s/^\s+|\s+$//g;
    $current =~ s/<br>/\n/g;
    push @cells, $current;
    next if @cells < 7 || $cells[0] eq "";
    print join("\t", @cells[0, 1, 2]), "\n";
  ' "$file"
}

issue_row_count() {
  local file=$1

  ledger_issue_rows "$file" | wc -l | tr -d '[:space:]'
}

unfinished_issue_rows() {
  local file=$1

  ledger_issue_rows "$file" | awk -F '\t' '
    $2 != "Done" && $2 != "Completed" {
      print "- " $1 " is " $2 " (" $3 ")"
    }
  '
}

upsert_issue_row() {
  local file=$1
  local issue=$2
  local linear_status=$3
  local agent_state=$4
  local agent=$5
  local worktree=$6
  local verification=$7
  local now
  local tmp
  local row
  local safe_issue
  local safe_linear_status
  local safe_agent_state
  local safe_agent
  local safe_worktree
  local safe_verification

  now=$(timestamp)
  safe_issue=$(escape_table_cell "$issue")
  safe_linear_status=$(escape_table_cell "$linear_status")
  safe_agent_state=$(escape_table_cell "$agent_state")
  safe_agent=$(escape_table_cell "$agent")
  safe_worktree=$(escape_table_cell "$worktree")
  safe_verification=$(escape_table_cell "$verification")
  row="| $safe_issue | $safe_linear_status | $safe_agent_state | $safe_agent | $safe_worktree | $now | $safe_verification |"
  tmp=$(mktemp)
  awk -v issue="$issue" \
      -v row="$row" '
    BEGIN { replaced=0; inserted=0 }
    $0 ~ "^\\|[[:space:]]*" issue "[[:space:]]*\\|" {
      print row
      replaced=1
      next
    }
    /^## Decisions/ && replaced == 0 && inserted == 0 {
      print row
      inserted=1
    }
    { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

print_mcp_plan() {
  local action=$1
  local issue=$2
  local state=$3
  local comment=$4

  cat <<EOF
Required Linear MCP actions:
1. _save_issue(id="$issue", state="$state")
2. _save_comment(issueId="$issue", body=<comment body below>)
3. Verify with _list_issues(query="$issue") and confirm state="$state".
4. If verification fails, leave a comment describing intended state, observed state, and next retry point.
Transition recorded locally: $action

Comment body:
\`\`\`md
$comment
\`\`\`
EOF
}

print_handoff_plan() {
  local comment=$1

  cat <<EOF
Required Linear MCP actions:
1. _save_comment(issueId="<active-or-operating-guide-issue>", body=<comment body below>)
2. Verify with _list_comments(issueId="<active-or-operating-guide-issue>") and confirm the handoff comment exists.
3. Reconcile with _list_issues(project="<project-name>") before choosing the next issue.
4. If verification fails, retry the comment once and record the mismatch in the ledger.
Transition recorded locally: handoff

Comment body:
\`\`\`md
$comment
\`\`\`
EOF
}

print_finalize_plan() {
  local comment=$1

  cat <<EOF
Required Linear MCP actions:
1. _save_comment(issueId="<operating-guide-or-final-verification-issue>", body=<comment body below>)
2. Verify with Linear project read-back that no Todo or In Progress issues remain.
3. If any unfinished issue remains, reopen the ledger with linear-agent start/block/handoff before calling the project complete.
Transition recorded locally: finalize

Comment body:
\`\`\`md
$comment
\`\`\`
EOF
}

apply_linear_transition() {
  local action=$1
  local issue=$2
  local state=$3
  local comment=$4

  PYTHONPATH="$SKILL_DIR/lib${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m linear_agent.graphql apply-transition \
      --issue "$issue" \
      --state "$state" \
      --comment "$comment" \
      --action "$action"
}

parse_common_transition_args() {
  LEDGER=
  AGENT=${AGENT:-Codex}
  WORKTREE=${WORKTREE:-}
  NOTE=${NOTE:-}
  NEXT=${NEXT:-}
  VERIFICATION=${VERIFICATION:-}
  DEPENDENCIES=${DEPENDENCIES:-}
  PRODUCTION_GATES=${PRODUCTION_GATES:-}
  SINK_GATES=${SINK_GATES:-}
  PARALLEL_WRITE=0
  APPLY_LINEAR=${LINEAR_AGENT_APPLY:-0}
  LINEAR_RECONCILED=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ledger) need_value "$1" "${2:-}"; LEDGER=$2; shift 2 ;;
      --agent) need_value "$1" "${2:-}"; AGENT=$2; shift 2 ;;
      --worktree) need_value "$1" "${2:-}"; WORKTREE=$2; shift 2 ;;
      --note) need_value "$1" "${2:-}"; NOTE=$2; shift 2 ;;
      --next) need_value "$1" "${2:-}"; NEXT=$2; shift 2 ;;
      --verification) need_value "$1" "${2:-}"; VERIFICATION=$2; shift 2 ;;
      --dependencies) need_value "$1" "${2:-}"; DEPENDENCIES=$2; shift 2 ;;
      --production-gates) need_value "$1" "${2:-}"; PRODUCTION_GATES=$2; shift 2 ;;
      --sink-gates) need_value "$1" "${2:-}"; SINK_GATES=$2; shift 2 ;;
      --parallel-write) PARALLEL_WRITE=1; shift ;;
      --apply-linear) APPLY_LINEAR=1; shift ;;
      --dry-run) APPLY_LINEAR=0; shift ;;
      --linear-reconciled) LINEAR_RECONCILED=1; shift ;;
      *) echo "Unknown option: $1" >&2; usage ;;
    esac
  done

  if [ -z "$LEDGER" ]; then
    echo "Missing --ledger" >&2
    exit 2
  fi
  if [ ! -f "$LEDGER" ]; then
    echo "Ledger not found: $LEDGER" >&2
    exit 1
  fi
}

init_ledger() {
  local ledger=
  local project=
  local prompt=
  local linear_project=
  local repo=
  local base_branch=
  local force=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ledger) need_value "$1" "${2:-}"; ledger=$2; shift 2 ;;
      --project) need_value "$1" "${2:-}"; project=$2; shift 2 ;;
      --prompt) need_value "$1" "${2:-}"; prompt=$2; shift 2 ;;
      --linear-project) need_value "$1" "${2:-}"; linear_project=$2; shift 2 ;;
      --repo) need_value "$1" "${2:-}"; repo=$2; shift 2 ;;
      --base-branch) need_value "$1" "${2:-}"; base_branch=$2; shift 2 ;;
      --force) force=1; shift ;;
      *) echo "Unknown option: $1" >&2; usage ;;
    esac
  done

  [ -n "$ledger" ] || { echo "Missing --ledger" >&2; exit 2; }
  [ -n "$project" ] || { echo "Missing --project" >&2; exit 2; }
  [ -n "$prompt" ] || { echo "Missing --prompt" >&2; exit 2; }
  [ -f "$TEMPLATE" ] || { echo "Template not found: $TEMPLATE" >&2; exit 1; }
  if [ -e "$ledger" ] && [ "$force" -ne 1 ]; then
    echo "Ledger already exists: $ledger (use --force to overwrite)" >&2
    exit 1
  fi

  mkdir -p "$(dirname -- "$ledger")"
  cp "$TEMPLATE" "$ledger"
  replace_line "$ledger" "# Linear Execution Ledger:" "# Linear Execution Ledger: $project"
  replace_line "$ledger" "<Paste the user request" "$prompt"
  replace_line "$ledger" "- Linear project:" "- Linear project: ${linear_project:-$project}"
  replace_line "$ledger" "- Repository:" "- Repository: $repo"
  replace_line "$ledger" "- Base branch:" "- Base branch: $base_branch"
  replace_line "$ledger" "- Ledger path:" "- Ledger path: $ledger"
  replace_line "$ledger" "- Overall status:" "- Overall status: initialized"
  replace_line "$ledger" "- Last verified:" "- Last verified: $(timestamp)"
  replace_line "$ledger" "- Next safest action:" "- Next safest action: create or reconcile Linear issues, then claim the first dependency-ready issue"
  append_activity "$ledger" "Ledger initialized for $project."

  echo "Ledger initialized: $ledger"
}

transition_issue() {
  local action=$1
  local issue=${2:-}
  shift 2 || true

  [ -n "$issue" ] || usage
  parse_common_transition_args "$@"

  local linear_status
  local agent_state
  local comment
  local current_worktree
  local overall_status=
  local active_issue_value=
  local active_agent_value=
  local active_worktree_value=
  local next_safest_action=

  current_worktree=$(existing_worktree "$LEDGER" "$issue" | trim)
  if [ -z "$WORKTREE" ]; then
    WORKTREE=$current_worktree
  fi
  if [ "$action" = "start" ] && [ "$PARALLEL_WRITE" -eq 1 ] && [ -z "$WORKTREE" ]; then
    echo "start --parallel-write requires --worktree" >&2
    exit 2
  fi

  case "$action" in
    start)
      linear_status="In Progress"
      agent_state="agent:executing"
      comment="Started work. Agent: $AGENT. Worktree: ${WORKTREE:-n/a}. Parallel write: $([ "$PARALLEL_WRITE" -eq 1 ] && printf yes || printf no). Note: ${NOTE:-claimed for execution}."
      overall_status="executing"
      active_issue_value="$issue"
      active_agent_value="$AGENT"
      active_worktree_value="$WORKTREE"
      next_safest_action="execute $issue and record verification before completion"
      ;;
    block)
      linear_status="In Progress"
      agent_state="agent:blocked"
      comment="Blocked. Agent: $AGENT. Blocker: ${NOTE:-not specified}. Safest next action: ${NEXT:-choose another dependency-ready issue}."
      overall_status="blocked"
      active_issue_value="$issue"
      active_agent_value="$AGENT"
      next_safest_action="${NEXT:-resolve blocker or choose another dependency-ready issue}"
      ;;
    verify)
      linear_status="In Progress"
      agent_state="agent:verifying"
      comment="Verification update. Agent: $AGENT. Verification: ${VERIFICATION:-not specified}. Note: ${NOTE:-none}."
      overall_status="verifying"
      active_issue_value="$issue"
      active_agent_value="$AGENT"
      next_safest_action="complete $issue only after verification and Linear read-back pass"
      ;;
    complete)
      [ -n "$VERIFICATION" ] || { echo "complete requires --verification" >&2; exit 2; }
      linear_status="Done"
      agent_state="agent:pr-ready"
      comment="Completed. Agent: $AGENT. Verification: $VERIFICATION. Note: ${NOTE:-none}."
      overall_status="issue completed"
      active_issue_value="$issue"
      active_agent_value="$AGENT"
      next_safest_action="reconcile Linear, then choose the next dependency-ready issue"
      ;;
    *) usage ;;
  esac

  if [ "$APPLY_LINEAR" = "1" ]; then
    apply_linear_transition "$action" "$issue" "$linear_status" "$comment" || {
      append_activity "$LEDGER" "$issue $action failed before ledger confirmation. Intended Linear state: $linear_status."
      exit 1
    }
  fi

  [ -z "$overall_status" ] || replace_line "$LEDGER" "- Overall status:" "- Overall status: $overall_status"
  [ -z "$active_issue_value" ] || replace_line "$LEDGER" "- Active issue:" "- Active issue: $active_issue_value"
  [ -z "$active_agent_value" ] || replace_line "$LEDGER" "- Active agent:" "- Active agent: $active_agent_value"
  [ -z "$active_worktree_value" ] || replace_line "$LEDGER" "- Active worktree:" "- Active worktree: $active_worktree_value"
  [ -z "$next_safest_action" ] || replace_line "$LEDGER" "- Next safest action:" "- Next safest action: $next_safest_action"
  replace_line "$LEDGER" "- Last verified:" "- Last verified: $(timestamp)"
  upsert_issue_row "$LEDGER" "$issue" "$linear_status" "$agent_state" "$AGENT" "$WORKTREE" "${VERIFICATION:-pending}"
  append_activity "$LEDGER" "$issue $action. $comment"
  if [ "$APPLY_LINEAR" = "1" ]; then
    cat <<EOF
Linear automation applied and read-back verified.
Transition recorded locally: $action
EOF
  else
    print_mcp_plan "$action" "$issue" "$linear_status" "$comment"
  fi
}

handoff() {
  parse_common_transition_args "$@"
  local comment

  comment="Handoff. Agent: $AGENT. Note: ${NOTE:-none}. Next: ${NEXT:-read ledger, reconcile Linear, then continue from the highest-priority unblocked issue}."
  replace_line "$LEDGER" "- Overall status:" "- Overall status: handoff"
  replace_line "$LEDGER" "- Last verified:" "- Last verified: $(timestamp)"
  replace_line "$LEDGER" "- Next safest action:" "- Next safest action: ${NEXT:-read ledger, reconcile Linear, then continue from the highest-priority unblocked issue}"
  append_activity "$LEDGER" "$comment"
  print_handoff_plan "$comment"
}

apply_gate_item() {
  local ledger=$1
  local label=$2
  local value=$3

  case "$value" in
    satisfied)
      set_check_item "$ledger" "$label" "x" "$label"
      ;;
    not-applicable:*)
      local reason=${value#not-applicable:}
      if [ -z "$reason" ]; then
        echo "$label requires a reason after not-applicable:" >&2
        exit 2
      fi
      set_check_item "$ledger" "$label" "~" "$label (N/A: $reason)"
      ;;
    *)
      echo "$label must be 'satisfied' or 'not-applicable:<reason>'" >&2
      exit 2
      ;;
  esac
}

finalize() {
  parse_common_transition_args "$@"
  [ -n "$VERIFICATION" ] || { echo "finalize requires --verification" >&2; exit 2; }
  [ "$LINEAR_RECONCILED" -eq 1 ] || { echo "finalize requires --linear-reconciled after a successful Linear/project read-back" >&2; exit 2; }
  [ -n "$DEPENDENCIES" ] || { echo "finalize requires --dependencies" >&2; exit 2; }
  [ -n "$PRODUCTION_GATES" ] || { echo "finalize requires --production-gates" >&2; exit 2; }
  [ -n "$SINK_GATES" ] || { echo "finalize requires --sink-gates" >&2; exit 2; }

  local comment
  local row_count
  local unfinished

  row_count=$(issue_row_count "$LEDGER")
  if [ "$row_count" -eq 0 ]; then
    echo "finalize refuses an empty Issue Progress table; reconcile or record completed issue rows first" >&2
    exit 1
  fi

  unfinished=$(unfinished_issue_rows "$LEDGER")
  if [ -n "$unfinished" ]; then
    echo "finalize refuses unfinished issue rows:" >&2
    printf '%s\n' "$unfinished" >&2
    exit 1
  fi

  comment="Finalized ledger. Agent: $AGENT. Verification: $VERIFICATION. Note: ${NOTE:-none}."

  ensure_checklist_legend "$LEDGER"
  ensure_final_reconciliation_item "$LEDGER"

  replace_line "$LEDGER" "- Overall status:" "- Overall status: completed"
  replace_line "$LEDGER" "- Active issue:" "- Active issue: None"
  replace_line "$LEDGER" "- Active agent:" "- Active agent: $AGENT"
  replace_line "$LEDGER" "- Active worktree:" "- Active worktree: None"
  replace_line "$LEDGER" "- Last verified:" "- Last verified: $(timestamp)"
  replace_line "$LEDGER" "- Next safest action:" "- Next safest action: Project complete; reopen only for new findings or expanded verification scope"

  set_check_item "$LEDGER" "Project created or selected" "x" "Project created or selected"
  set_check_item "$LEDGER" "Operating guide issue created" "x" "Operating guide issue created"
  set_check_item "$LEDGER" "Verification matrix issue created" "x" "Verification matrix issue created"
  set_check_item "$LEDGER" "Milestones created" "x" "Milestones created"
  set_check_item "$LEDGER" "Parent workstreams created" "x" "Parent workstreams created"
  set_check_item "$LEDGER" "Child issues created" "x" "Child issues created"
  set_check_item "$LEDGER" "Labels applied" "x" "Labels applied"
  apply_gate_item "$LEDGER" "Dependencies/blockers linked" "$DEPENDENCIES"
  apply_gate_item "$LEDGER" "Production gates created if needed" "$PRODUCTION_GATES"
  apply_gate_item "$LEDGER" "Sink/output preservation gates created if needed" "$SINK_GATES"
  set_check_item "$LEDGER" "Project status update or operating-guide comment posted" "x" "Project status update or operating-guide comment posted"

  set_check_item "$LEDGER" "First issue chosen by dependency order" "x" "First issue chosen by dependency order"
  set_check_item "$LEDGER" "Active issue moved to In Progress" "x" "Active issue moved to In Progress"
  set_check_item "$LEDGER" "Active issue acknowledgement comment posted" "x" "Active issue acknowledgement comment posted"
  set_check_item "$LEDGER" "Worktree or workspace recorded" "x" "Worktree or workspace recorded"
  set_check_item "$LEDGER" "Verification run recorded" "x" "Verification run recorded"
  set_check_item "$LEDGER" "Completion comment posted" "x" "Completion comment posted"
  set_check_item "$LEDGER" "Active issue moved to Done only after verification" "x" "Active issue moved to Done only after verification"
  set_check_item "$LEDGER" "Follow-up issues created or linked" "x" "Follow-up issues created or linked"
  set_check_item "$LEDGER" "Final verification/release gate completed" "x" "Final verification/release gate completed"
  set_check_item "$LEDGER" "Final ledger reconciliation completed" "x" "Final ledger reconciliation completed"

  remove_empty_issue_row "$LEDGER"
  append_activity "$LEDGER" "$comment"
  print_finalize_plan "$comment"
}

agent_state_for_linear_status() {
  case "$1" in
    Done|Completed) printf 'agent:pr-ready' ;;
    *) printf 'agent:blocked' ;;
  esac
}

apply_reconcile_results() {
  local output_file=$1
  local line
  local issue
  local ledger_status
  local linear_status
  local detail
  local worktree

  while IFS= read -r line; do
    case "$line" in
      mismatch\ \|\ *\ \|\ ledger=*\ \|\ linear=*)
        issue=$(printf '%s\n' "$line" | awk -F ' \\| ' '{ print $2 }')
        ledger_status=$(printf '%s\n' "$line" | sed -n 's/^mismatch | [^|]* | ledger=\([^|]*\) | linear=.*/\1/p')
        linear_status=$(printf '%s\n' "$line" | sed -n 's/^mismatch | [^|]* | ledger=[^|]* | linear=//p')
        worktree=$(existing_worktree "$LEDGER" "$issue" | trim)
        upsert_issue_row "$LEDGER" "$issue" "$linear_status" "$(agent_state_for_linear_status "$linear_status")" "$AGENT" "$worktree" "Reconciled from Linear: ledger was $ledger_status; Linear is $linear_status"
        ;;
      missing\ \|\ *\ \|\ *)
        issue=$(printf '%s\n' "$line" | awk -F ' \\| ' '{ print $2 }')
        detail=$(printf '%s\n' "$line" | awk -F ' \\| ' '{ print $3 }')
        worktree=$(existing_worktree "$LEDGER" "$issue" | trim)
        upsert_issue_row "$LEDGER" "$issue" "Missing in Linear" "agent:blocked" "$AGENT" "$worktree" "Reconcile could not read Linear issue: $detail"
        ;;
    esac
  done <"$output_file"
}

reconcile() {
  parse_common_transition_args "$@"
  local output_file
  local reconcile_rc
  local summary

  output_file=$(mktemp)
  set +e
  PYTHONPATH="$SKILL_DIR/lib${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m linear_agent.graphql reconcile --ledger "$LEDGER" \
    >"$output_file" 2>&1
  reconcile_rc=$?
  set -e

  cat "$output_file"
  summary=$(tr '\n' '; ' <"$output_file" | sed 's/[[:space:]]*$//')
  apply_reconcile_results "$output_file"
  rm -f "$output_file"
  if [ -z "$summary" ]; then
    summary="no issue rows found"
  fi
  if [ "$reconcile_rc" -eq 0 ]; then
    replace_line "$LEDGER" "- Overall status:" "- Overall status: reconciled"
    replace_line "$LEDGER" "- Last verified:" "- Last verified: $(timestamp)"
    append_activity "$LEDGER" "Linear reconciliation passed. Summary: $summary"
  else
    replace_line "$LEDGER" "- Overall status:" "- Overall status: reconciliation drift found"
    replace_line "$LEDGER" "- Last verified:" "- Last verified: $(timestamp)"
    replace_line "$LEDGER" "- Next safest action:" "- Next safest action: inspect reconciled drift rows before claiming or completing more work"
    append_activity "$LEDGER" "Linear reconciliation found drift. Summary: $summary"
  fi
  return "$reconcile_rc"
}

case "$COMMAND" in
  init) init_ledger "$@" ;;
  start|block|verify|complete) transition_issue "$COMMAND" "$@" ;;
  handoff) handoff "$@" ;;
  finalize) finalize "$@" ;;
  reconcile) reconcile "$@" ;;
  -h|--help|help) usage 0 ;;
  *) usage ;;
esac
